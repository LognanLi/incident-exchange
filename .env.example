# ---------------------------------------------------------------------------
# Frontend (.env.local) — written automatically by `npm run setup` / `convex dev`.
# ---------------------------------------------------------------------------
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent
# VITE_CONVEX_URL=http://127.0.0.1:3210

# ---------------------------------------------------------------------------
# Server-side integration secrets. These are NOT read from this file.
# Set them on the Convex deployment so they never reach the browser bundle:
#   npx convex env set APIFY_TOKEN <your-token>
# The app runs fully without any of them (clearly labeled demo adapters).
# ---------------------------------------------------------------------------
# APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
# APIFY_ACTOR_ID=apify~website-content-crawler   # optional override
# DEMO_MODE=off                                  # disables reset/seed controls

# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=
# FACTORY_RUNNER_SECRET=<random hex; also put it in .secrets.local for the runner>

# ---------------------------------------------------------------------------
# .secrets.local (gitignored) — read by scripts/factory-runner.mjs
# ---------------------------------------------------------------------------
# FACTORY_API_KEY=fk-...
# FACTORY_RUNNER_SECRET=<same value as on Convex>

# Coinbase x402 on Base Sepolia (CDP Server Wallets) — Convex env only:
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# X402_TEST_PRICE_DIVISOR=100                    # optional; test charge = list price / divisor
# X402_FACILITATOR_URL=https://x402.org/facilitator   # optional; default is the CDP facilitator

# Not wired yet — waiting on event documentation:
# ARMADIN_API_KEY=
