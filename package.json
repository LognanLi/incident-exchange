{
  "name": "incident-exchange",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "dev": "npm-run-all --parallel dev:backend dev:frontend dev:factory",
    "dev:frontend": "vite --open=false",
    "dev:backend": "convex dev",
    "dev:factory": "node scripts/factory-runner.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "test": "vitest run && node --test toy-apps/toy.test.mjs",
    "e2e": "node e2e/demo-flow.mjs",
    "demo:reset": "convex run demo:reset",
    "x402:setup": "convex run x402Node:setup",
    "test:toys": "node --test toy-apps/toy.test.mjs",
    "agents:setup": "node scripts/agents-setup.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@moss-js/moss": "^1.21.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "convex": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "convex-test": "^0.0.65",
    "droid": "^0.249.0",
    "npm-run-all2": "^9.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
